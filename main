<script>
const camtelLogoSVG = `
<svg class="logo-svg" viewBox="0 0 220 60" xmlns="http://www.w3.org/2000/svg">
  <circle cx="22" cy="30" r="18" fill="#0066B3"/>
  <path d="M22 18 Q14 22 14 30 Q14 38 22 42 Q30 38 30 30 Q30 22 22 18 Z" fill="#fff"/>
  <circle cx="22" cy="28" r="3" fill="#0066B3"/>
  <path d="M16 34 Q22 38 28 34" stroke="#0066B3" stroke-width="2" fill="none"/>
  <text x="50" y="40" font-family="Arial Black, Arial" font-size="30" font-weight="900" fill="#0066B3">camtel</text>
  <text x="195" y="22" font-size="10" fill="#0066B3">R</text>
</svg>`;

document.querySelectorAll('.tab').forEach(t=>{
  t.onclick=()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    document.getElementById('panel-'+t.dataset.tab).classList.add('active');
    if(t.dataset.tab==='fiche')renderFiche();
    if(t.dataset.tab==='virement')renderVirement();
    if(t.dataset.tab==='pv')renderPV();
  };
});

let ficheLines=[
  {acct:'4011 7270',lib:'REGLEMENT VIRT FAV ETS IKRAM UBA ABBIA Motif: RGMT BC N°248053 18/08/2',deb:'2 443 433',cre:''},
  {acct:'4441 0022',lib:'TVA / VIRT FAV ETS IKRAM UBA ABBIA Motif: RGMT BC N°248053 18/08/2',deb:'',cre:'394 433'},
  {acct:'4471 0100',lib:'IR/ VIRT FAV ETS IKRAM UBA ABBIA Motif: RGMT BC N°248053 18/08/2',deb:'',cre:'112 695'},
  {acct:'5211 0324',lib:'VIRT FAV ETS IKRAM UBA ABBIA Motif: RGMT BC N°248053 18/08/2',deb:'',cre:'1 936 305'}
];

function renderFicheLines(){
  const c=document.getElementById('fiche-lines');c.innerHTML='';
  ficheLines.forEach((l,i)=>{
    c.innerHTML+=`<div class="li">
      <input value="${l.acct}" onchange="ficheLines[${i}].acct=this.value">
      <input value="${l.lib}" onchange="ficheLines[${i}].lib=this.value">
      <input value="${l.deb}" onchange="ficheLines[${i}].deb=this.value">
      <input value="${l.cre}" onchange="ficheLines[${i}].cre=this.value">
      <button class="btn red" style="padding:4px 8px;font-size:11px;margin:0;" onclick="ficheLines.splice(${i},1);renderFicheLines()">x</button>
    </div>`;
  });
}
function addFicheLine(){ficheLines.push({acct:'',lib:'',deb:'',cre:''});renderFicheLines();}
renderFicheLines();

function sumAmt(arr,key){
  let s=0;arr.forEach(l=>{let n=parseFloat((l[key]||'').replace(/[\s,]/g,''));if(!isNaN(n))s+=n;});
  return s.toLocaleString('fr-FR').replace(/,/g,' ');
}

function renderFiche(){
  const date=document.getElementById('f_date').value;
  const type=document.getElementById('f_type').value;
  const num=document.getElementById('f_num').value;
  let rows='';
  for(let i=0;i<Math.max(20,ficheLines.length);i++){
    const l=ficheLines[i]||{acct:'',lib:'',deb:'',cre:''};
    rows+=`<tr style="height:28px;"><td class="acct">${l.acct||''}</td><td>${l.lib||''}</td><td class="amt">${l.deb||''}</td><td class="amt">${l.cre||''}</td></tr>`;
  }
  const totD=sumAmt(ficheLines,'deb'),totC=sumAmt(ficheLines,'cre');
  const html=`<div class="page" id="fiche-page"><div class="watermark">CAMTEL</div><div class="logo-row">${camtelLogoSVG}</div><div class="doc-title">FICHE D'IMPUTATION</div><div class="doc-meta"><div><strong>DATE :</strong> ${date}</div><div><strong>PIECE N°</strong> ${type} <span style="border-bottom:1px solid #000;padding:0 8px;">${num}</span></div></div><table class="imp-table"><thead><tr><th style="width:22%">N° DE COMPTE</th><th>LIBELLES</th><th style="width:15%">DEBIT</th><th style="width:15%">CREDIT</th></tr></thead><tbody>${rows}</tbody><tfoot><tr class="footer-totals"><td colspan="2"></td><td>${totD}</td><td>${totC}</td></tr></tfoot></table></div>`;
  document.getElementById('preview').innerHTML=html;
}

function renderVirement(){
  const v=k=>document.getElementById(k).value;
  const html=`<div class="page" id="virement-page"><div class="watermark">CAMTEL</div><div class="ov-header"><div class="ov-left">${camtelLogoSVG}<div class="logo-sub"><em>Représentation Régionale<br>du Nord<br>Business Unit Fixe</em></div><div class="ov-num">N° ${v('v_num')} /RRNF/SAAF</div></div><div class="ov-right">${v('v_lieu')}, le<br><strong>${v('v_date')}</strong></div></div><div class="ov-to">MONSIEUR LE REPRÉSENTANT RÉGIONAL CAMTEL<br>DE LA BUSINESS UNIT FIXE POUR LE NORD,<br>A<br>MONSIEUR LE CHEF D'AGENCE BICEC DE GAROUA.</div><p style="font-size:13px;"><strong><u>Objet</u> :</strong> Ordre de virement.</p><div class="ov-body"><p>Monsieur le Chef d'Agence,</p><p>Par le débit de notre compte N° ${v('v_compte_deb')}, nous avons l'honneur de vous demander de bien vouloir effectuer le virement en faveur des ${v('v_ets')} selon le tableau ci-après :</p><table class="ov-table"><thead><tr><th>Bénéficiaire</th><th>Numéro de compte</th><th>Domiciliation</th><th>Montant</th></tr></thead><tbody><tr><td>${v('v_benef')}</td><td>${v('v_compte_ben')}</td><td>${v('v_dom')}</td><td>${v('v_mt')}</td></tr><tr class="ov-total"><td colspan="3" style="text-align:left;"><strong>TOTAL</strong></td><td><strong>${v('v_mt')}</strong></td></tr></tbody></table><p>Cette somme de <strong>${v('v_mt_lettres')} Francs</strong> représente le règlement du BC N° ${v('v_bc')} des ${v('v_ets')} relatif à la ${v('v_objet')}.</p><p>Veuillez recevoir, Monsieur le chef d'Agence, L'assurance de notre parfaite considération.</p></div><div class="sig"><strong>Le Représentant<br>Régional du Nord<br>BUSINESS UNIT FIXE</strong><div style="height:60px;"></div><strong>${v('v_sig')}</strong></div><div class="footer-camtel">S.A. CAMEROON TELECOMMUNICATIONS (CAMTEL)<br>Capital social : 67 904 430 000 FCFA, B.P. : 27 Garoua-Cameroun<br>N° RCCM : 2000 Q 255, N° Contribuable M 0998 0000 9853 S<br>TELEPHONE : (237) 222 27 19 55  Fax (237) 222 27 28 90</div></div>`;
  document.getElementById('preview').innerHTML=html;
}

function renderPV(){
  const v=k=>document.getElementById(k).value;
  const html=`<div class="page" id="pv-page"><div class="watermark">CAMTEL</div><div class="pv-header"><div class="pv-h-logo">${camtelLogoSVG}</div><div class="pv-h-title">PROCES-VERBAL DE RECEPTION</div><div class="pv-h-meta">Code : EN-DAP-14<br>Version : 0<br>Date : 30/08/2024<br>Page : 1/2</div></div><div class="pv-title">PROCES VERBAL DE RECEPTION DEFINITIVE</div><div class="pv-body"><p>Bon de Commande <strong>n°${v('p_bc')}</strong> du <strong>${v('p_date_bc')}</strong>, Pour ${v('p_objet')}.</p><p>L'an deux mille ${v('p_an')}, le ${v('p_jour')} du mois d'${v('p_mois')} ${v('p_an')} à partir de ${v('p_heure')}.</p><p>Nous soussignés</p><p>M ...... <span class="pv-line">${v('p_pres')}</span> ........[Le Président ou son représentant]</p><p>M ...... <span class="pv-line">${v('p_m1')}</span> ........[Membre]</p><p>Mme ...... <span class="pv-line">${v('p_m2')}</span> ........[Membre]</p><p>M ...... <span class="pv-line">${v('p_m3')}</span> ........[Membre]</p><p>M ...... <span class="pv-line">${v('p_m4')}</span> ........[Membre]</p><p>M ...... <span class="pv-line">${v('p_rap')}</span> ........[Rapporteur]</p><p>Accompagnés de :</p><p>M ...... <span class="pv-line">${v('p_coco')}</span> ........[Cocontractant]</p><p>En présence de Cocontractant dûment convoqué, sommes rendus sur les lieux pour examiner et vérifier les prestations réalisées par <strong>${v('p_four')}</strong> dans le cadre du Bon de Commande ci-dessus mentionné à la page n°${v('p_bc')}.</p><p>Au terme de cet examen et tenant compte du bordereau de livraison signée par le magasinier joint, nous déclarons que :</p><p>La réception Provisoire est <strong>prononcée sans réserve</strong>, avec effet à la date du ${v('p_jour')} ${v('p_mois')} ${v('p_an')}.</p><p style="text-align:right;">Fait à ${v('p_lieu')}, le ${v('p_pv_date')}, en un original</p></div><div class="pv-sig-grid"><div class="s"><span>Cocontractant</span></div><div class="s"><span>Rapporteur</span></div><div class="s"><span>Membre</span>${v