function downloadPDF(pageId,filename){
  const el=document.getElementById(pageId);
  if(!el){alert('Cliquez d\'abord sur Aperçu');return;}
  const opt={margin:0,filename:filename+'.pdf',image:{type:'jpeg',quality:0.98},html2canvas:{scale:2,useCORS:true},jsPDF:{unit:'mm',format:'a4',orientation:'portrait'}};
  html2pdf().set(opt).from(el).save();
}

async function downloadWord(type){
  const {Document,Packer,Paragraph,TextRun,Table,TableRow,TableCell,WidthType,AlignmentType,PageOrientation,Header,Footer}=docx;
  const camtelHeaderPara=new Paragraph({alignment:AlignmentType.LEFT,children:[new TextRun({text:'camtel',bold:true,size:48,color:'0066B3'})]});
  let docChildren=[];

  if(type==='fiche'){
    const date=document.getElementById('f_date').value;
    const ttype=document.getElementById('f_type').value;
    const num=document.getElementById('f_num').value;
    docChildren.push(camtelHeaderPara);
    docChildren.push(new Paragraph({alignment:AlignmentType.CENTER,spacing:{before:300,after:200},children:[new TextRun({text:"FICHE D'IMPUTATION",bold:true,size:40})]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:`DATE : ${date}                              PIECE N°  ${ttype}  ${num}`,bold:true,size:22})]}));
    const headerRow=new TableRow({tableHeader:true,children:[
      new TableCell({width:{size:25,type:WidthType.PERCENTAGE},children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'N° DE COMPTE',bold:true})]})]}),
      new TableCell({width:{size:45,type:WidthType.PERCENTAGE},children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'LIBELLES',bold:true})]})]}),
      new TableCell({width:{size:15,type:WidthType.PERCENTAGE},children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'DEBIT',bold:true})]})]}),
      new TableCell({width:{size:15,type:WidthType.PERCENTAGE},children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'CREDIT',bold:true})]})]})
    ]});
    const dataRows=ficheLines.map(l=>new TableRow({children:[
      new TableCell({children:[new Paragraph({children:[new TextRun({text:l.acct,font:'Courier New'})]})]}),
      new TableCell({children:[new Paragraph({children:[new TextRun({text:l.lib,size:18})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun({text:l.deb,bold:true})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun({text:l.cre,bold:true})]})]}),
    ]}));
    for(let i=0;i<10;i++){
      dataRows.push(new TableRow({children:[new TableCell({children:[new Paragraph('')]}),new TableCell({children:[new Paragraph('')]}),new TableCell({children:[new Paragraph('')]}),new TableCell({children:[new Paragraph('')]})]}));
    }
    const totD=sumAmt(ficheLines,'deb'),totC=sumAmt(ficheLines,'cre');
    dataRows.push(new TableRow({children:[
      new TableCell({children:[new Paragraph('')]}),
      new TableCell({children:[new Paragraph('')]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun({text:totD,bold:true})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun({text:totC,bold:true})]})]}),
    ]}));
    docChildren.push(new Table({rows:[headerRow,...dataRows],width:{size:100,type:WidthType.PERCENTAGE}}));
  }
  else if(type==='virement'){
    const v=k=>document.getElementById(k).value;
    docChildren.push(camtelHeaderPara);
    docChildren.push(new Paragraph({children:[new TextRun({text:'Représentation Régionale du Nord',italics:true,size:20})]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:'Business Unit Fixe',italics:true,size:20})]}));
    docChildren.push(new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun({text:`${v('v_lieu')}, le ${v('v_date')}`,bold:true})]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:`N° ${v('v_num')} /RRNF/SAAF`,bold:true,size:24})]}));
    docChildren.push(new Paragraph({alignment:AlignmentType.CENTER,spacing:{before:300,after:200},children:[
      new TextRun({text:'MONSIEUR LE REPRÉSENTANT RÉGIONAL CAMTEL',bold:true,break:1}),
      new TextRun({text:'DE LA BUSINESS UNIT FIXE POUR LE NORD,',bold:true,break:1}),
      new TextRun({text:'A',bold:true,break:1}),
      new TextRun({text:"MONSIEUR LE CHEF D'AGENCE BICEC DE GAROUA.",bold:true,break:1})
    ]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:'Objet : ',bold:true,underline:{}}),new TextRun({text:'Ordre de virement.'})]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:"Monsieur le Chef d'Agence,"})]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:`Par le débit de notre compte N° ${v('v_compte_deb')}, nous avons l'honneur de vous demander de bien vouloir effectuer le virement en faveur des ${v('v_ets')} selon le tableau ci-après :`})]}));
    const ovHeader=new TableRow({tableHeader:true,children:[
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'Bénéficiaire',bold:true})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'Numéro de compte',bold:true})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'Domiciliation',bold:true})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'Montant',bold:true})]})]}),
    ]});
    const ovData=new TableRow({children:[
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun(v('v_benef'))]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun(v('v_compte_ben'))]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun(v('v_dom'))]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun(v('v_mt'))]})]}),
    ]});
    const ovTotal=new TableRow({children:[
      new TableCell({columnSpan:3,children:[new Paragraph({children:[new TextRun({text:'TOTAL',bold:true})]})]}),
      new TableCell({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:v('v_mt'),bold:true})]})]}),
    ]});
    docChildren.push(new Table({rows:[ovHeader,ovData,ovTotal],width:{size:100,type:WidthType.PERCENTAGE}}));
    docChildren.push(new Paragraph({spacing:{before:200},children:[new TextRun(`Cette somme de ${v('v_mt_lettres')} Francs représente le règlement du BC N° ${v('v_bc')} des ${v('v_ets')} relatif à la ${v('v_objet')}.`)]}));
    docChildren.push(new Paragraph({children:[new TextRun("Veuillez recevoir, Monsieur le chef d'Agence, L'assurance de notre parfaite considération.")]}));
    docChildren.push(new Paragraph({alignment:AlignmentType.RIGHT,spacing:{before:400},children:[new TextRun({text:'Le Représentant Régional du Nord BUSINESS UNIT FIXE',bold:true})]}));
    docChildren.push(new Paragraph({alignment:AlignmentType.RIGHT,spacing:{before:1000},children:[new TextRun({text:v('v_sig'),bold:true})]}));
  }
  else if(type==='pv'){
    const v=k=>document.getElementById(k).value;
    docChildren.push(camtelHeaderPara);
    docChildren.push(new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'PROCES-VERBAL DE RECEPTION',bold:true,size:28})]}));
    docChildren.push(new Paragraph({alignment:AlignmentType.CENTER,spacing:{before:200,after:200},children:[new TextRun({text:'PROCES VERBAL DE RECEPTION DEFINITIVE',bold:true,underline:{},size:26})]}));
    docChildren.push(new Paragraph({children:[new TextRun({text:`Bon de Commande n°${v('p_bc')} du ${v('p_date_bc')}, Pour ${v('p_objet')}.`})]}));
    docChildren.push(new Paragraph({children:[new TextRun(`L'an deux mille ${v('p_an')}, le ${v('p_jour')} du mois d'${v('p_mois')} ${v('p_an')} à partir de ${v('p_heure')}.`)]}));
    docChildren.push(new Paragraph({children:[new TextRun('Nous soussignés')]}));
    [['Le Président ou son représentant',v('p_pres')],['Membre',v('p_m1')],['Membre',v('p_m2')],['Membre',v('p_m3')],['Membre',v('p_m4')],['Rapporteur',v('p_rap')]].forEach(([role,name])=>{
      docChildren.push(new Paragraph({children:[new TextRun(`M ...... `),new TextRun({text:name,bold:true,underline:{}}),new TextRun(` ............[${role}]`)]}));
    });
    docChildren.push(new Paragraph({children:[new TextRun('Accompagnés de :')]}));
    docChildren.push(new Paragraph({children:[new TextRun(`M ...... `),new TextRun({text:v('p_coco')||'_______________________',bold:true,underline:{}}),new TextRun(' ............[Cocontractant]')]}));
    docChildren.push(new Paragraph({children:[new TextRun(`En présence de Cocontractant dûment convoqué, sommes rendus sur les lieux pour examiner et vérifier les prestations réalisées par `),new TextRun({text:v('p_four'),bold:true}),new TextRun(` dans le cadre du Bon de Commande ci-dessus mentionné à la page n°${v('p_bc')}.`)]}));
    docChildren.push(new Paragraph({children:[new TextRun('Au terme de cet examen et tenant compte du bordereau de livraison signée par le magasinier joint, nous déclarons que :')]}));
    docChildren.push(new Paragraph({children:[new TextRun('La réception Provisoire est '),new TextRun({text:'prononcée sans réserve',bold:true}),new TextRun(`, avec effet à la date du ${v('p_jour')} ${v('p_mois')} ${v('p_an')}.`)]}));
    docChildren.push(new Paragraph({alignment:AlignmentType.RIGHT,children:[new TextRun(`Fait à ${v('p_lieu')}, le ${v('p_pv_date')}, en un original`)]}));
  }

  const doc=new Document({
    sections:[{
      properties:{page:{size:{orientation:PageOrientation.PORTRAIT,width:11906,height:16838},margin:{top:1000,right:1000,bottom:1000,left:1000}}},
      headers:{default:new Header({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'CAMTEL',bold:true,size:140,color:'E6F0F8'})]})]})},
      footers:{default:new Footer({children:[new Paragraph({alignment:AlignmentType.CENTER,children:[new TextRun({text:'S.A. CAMEROON TELECOMMUNICATIONS (CAMTEL) — B.P. 1571 Yaoundé / 27 Garoua — Tel: (237) 222 230 303',size:14,italics:true})]})]})},
      children:docChildren
    }]
  });

  const blob=await Packer.toBlob(doc);
  saveAs(blob,(type==='fiche'?'Fiche_Imputation':type==='virement'?'Ordre_Virement':'Proces_Verbal')+'.docx');
}

renderFiche();
</script>
</body>
</html>
